# Copy this file to .env.local and fill in the real values. Never commit .env.local.

# Neon Postgres connection string (use the pooled one, with -pooler in the hostname)
DATABASE_URL=
# Random secret used to hash visitor IP addresses for spam protection
IP_HASH_SALT=
# Email (Gmail SMTP with an App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_TO=
# The public address of the site (used in emails)
SITE_URL=
# Telegram notifications (create a bot with BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret